name: Build All In One Tool APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    name: Build Flutter APK
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Repository
      uses: actions/checkout@v3

    - name: Set up Java (LTS 17)
      uses: actions/setup-java@v3
      with:
        distribution: 'zulu'
        java-version: '17'

    - name: Set up Flutter SDK
      uses: subosito/flutter-action@v2
      with:
        flutter-version: '3.19.0'
        channel: 'stable'

    - name: Extract ZIP and Setup App Automatically
      run: |
        # ZIP file ko dhoond kar extract karna
        ZIP_FILE=$(ls *.zip | head -n 1)
        echo "Found ZIP: $ZIP_FILE"
        unzip "$ZIP_FILE" -d extracted_files/
        
        # Flutter project banana
        flutter create --org com.ayush.allinone all_in_one_tool
        
        # Agar zip ke andar pubspec.yaml aur lib hai toh unhe copy karna
        if [ -f "extracted_files/pubspec.yaml" ]; then
          cp extracted_files/pubspec.yaml all_in_one_tool/
        else
          # Agar zip me pubspec nahi mila toh default professional pubspec daal dena
          cd all_in_one_tool
          cat << 'EOF' > pubspec.yaml
name: all_in_one_tool
description: Clean & Premium Material 3 PDF & Image Suite.
publish_to: 'none'
version: 3.0.0+1
environment:
  sdk: '>=3.0.0 <4.0.0'
dependencies:
  flutter:
    sdk: flutter
  image_picker: ^1.0.7
  pdf: ^3.10.8
  image: ^4.1.3
  path_provider: ^2.1.2
  file_picker: ^6.1.1
  share_plus: ^7.2.1
  google_fonts: ^6.1.0
flutter:
  uses-material-design: true
EOF
          cd ..
        fi

        if [ -d "extracted_files/lib" ]; then
          cp -r extracted_files/lib/* all_in_one_tool/lib/
        endif
        if [ -d "extracted_files/assets" ]; then
          cp -r extracted_files/assets all_in_one_tool/
        endif

        cd all_in_one_tool
        flutter pub get

    - name: Build Release APK
      run: |
        cd all_in_one_tool
        flutter build apk --release --split-per-abi

    - name: Upload Final APK to GitHub Artifacts
      uses: actions/upload-artifact@v4
      with:
        name: AllInOneTool-CleanApp
        path: all_in_one_tool/build/app/outputs/flutter-apk/app-release.apk
